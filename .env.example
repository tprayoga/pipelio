# Salin menjadi .env lalu isi. JANGAN commit .env.
#
# Buat SECRET_KEY acak:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=pipelio
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=pipelio

SECRET_KEY=ganti-dengan-kunci-acak-panjang
APP_ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Akun admin pertama — dibuat sekali saat database masih kosong.
# Setelah login pertama, segera ganti passwordnya lewat menu "Ubah Password".
FIRST_ADMIN_EMAIL=admin@indotek.co.id
FIRST_ADMIN_PASSWORD=indotek12345
FIRST_ADMIN_NAME=Administrator

# Port aplikasi di server kantor.
WEB_PORT=8080
